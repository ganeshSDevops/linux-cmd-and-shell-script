✅ Interview-ready version
#!/bin/bash
set -e

filePath="$1"
threshold=$((100*1024*1024))

if [ -z "$filePath" ] || [ ! -f "$filePath" ]; then
  echo "Usage: $0 <file>"
  exit 1
fi

actualSize=$(stat -c %s "$filePath")

if [ "$actualSize" -ge "$threshold" ]; then
  backup="${filePath}_$(date +'%Y%m%d_%H%M%S')"

  cp "$filePath" "$backup"
  : > "$filePath"   # truncate safely

  echo "Rotated: $backup"

  # Example alert
  # aws sns publish --topic-arn <arn> --message "Log rotated $backup"
fi
